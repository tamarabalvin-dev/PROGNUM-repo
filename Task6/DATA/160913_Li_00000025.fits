€Г€Ш€В€Г€М€Й€Ж€У€Б€Т€и€µ€Э€ѕ€Е€ґ€К€И€Ч€М€І€Ы€Р€Щ€И€Л€ї€Ф€о€¤€ї€і€Ё€Ч€Д€Н€Г€К€і€є€Р€б€С€і€Л€А€М€ј€С€У€К€И€Ш€¦€З€і€Д€О€П€Е€Е€К€Э€е€ё€Ф€Щ€ѕ€И€и€Т€И€Н€В€И€ї€Д€Ь€№€ѕ€·€К€Ф€в€ї€Л€№€Є€Г€Й€·€є€Г€»€Ж€›€г€Ѕ€№€ї€№€С€А€и€№€В€К‰€Д€є€Ч€Ч€в€ѕ€±€З€»€У€«€И€Н€Л€ч€З€Ь€¶€З€Й€е€О€Е€З€Ь€Д€У€Т€Н€є€І€Е€Г€р€Ѕ€Л€а€Х€И€О€Ч€К€ё€В€Л€±€Э€¶€ї€Б€®€Т€Ч€У€В€Х€Ы€ї€і€Ч€Д€Х€Й€С€Х€¶€О€К€Р€К€­€Ч€Г€Ц€Й€К€ї€Й€ї€І€Е€З€ё€Н€е€Т€·€И€И€А€Щ€·€И€ё€є€Ф€Н€в€в€Ы€¶€ж€Г€У€№€Ы€С€Н€Ѕ€К€С€А€І€Р€П€Ц€Ю€Ч€Ц€Ч€Н€С€Л€Ї€»€¶€А€Ї€©€П€Й€М€і€К€»€Ц€ј€П€Н€г€З€О€Х€ё€З€Х€Х€І€Р€ї€а€ј€Э€ж€Ч€А€ј€Ю€С€З€д€р€ї€Ф€Й€Ф€Ц€·€Ю€Ю€Ъ€Э€Ѕ€»€Е€­€И€Ж€Е€К€В€ё€Х€Ъ€Л€г€Ж€Р€Э€С€Х€Я€В€Д€Д€ѕ€Г€П€Ё€ј€П€Э€ї€є€М€Г€ё€Н€»€°€Ѕ€И€О€С€И€К€И€§€¬€И€Б€М€Ч€ѕ€М€Ж€К€·€Е€¶€Г€Л€У€М€С€Л€Л€Л€В€М€Н€·€Н€П€Д€Ш€ї€В€У€Р€Ф€Ї€З€Й€т€М€Е€»€Ь€Е€є€Д€Б€І€є€Й€°€О€г€№€Ё€И€Б€·€а€О€В€ё€Ы€К€Л€ї€Ю€Л€Г€У€Н€Г€Э€і€­€В€Б€Ф€П€Ф€з€М€Ц€г€ѕ€ї€а€ї€Г€П€У€ъ€Е€П€С€н€Б€М€Й€Ж€Ъ€О€А€д€С€г€б€Ж€М€Ж€Ї€Ф€Ї€є€Х€З€М€Ч€Й€ѕ€Г€Ь€Н€Ш€Н€µ€Д€И€Є€Ф€М€А€Ъ€Г€Ж€ѕ€в€Л€Й€Х€Й€Э€ї€ћ€М€ј€Ж€Л€З€є€И€П€·€Е€Ѕ€ј€С€г€В€Ц€Ф€А€Щ€З€Ѕ€М€Ж€Ф€Г€ј€Р€»€Д€Ы€ѕ€є€Х€Ь€Г€Й€Щ€А€Д€Й€И€ј€Т€є€є€В€М€Щ€Л€ї€Г€Ф€Ц€Ў€е€Е€Т€П€В€Ф€В€ї€Ч€п€Р€±€Й€П€Щ€¬€ѕ€¬€±€ё€ѕ€Ѕ€Т€М€Р€Н€И€Е€¶€Ж€Ф€О€а€Й€Е€д€У€ж€Ж€є€Ъ€µ€Щ€З€№€­€Ю€А€П€Ж€И€Х€К€і€­€ѕ€И€У€™€Д€Й€Ц€Ч€Д€Ф€Ж€П€Л€Т€Т€Щ€Г€П€С€з€Д€·€Ч€И€Э€М€·€Е€Р€Д€є€Б€є€Ф€А€ї€К€Й€о€Ъ€П€З€И€С€Ч€з€Н€Ш€М€Ї€З€А€М€К€Н€Й€Ж€К€Е€Т€Ъ€У€№€О€Ѕ€Н€Л€Р€ї€Ф€Р€Х€ё€Л€И€Ж€Т€є€З€Ё€Г€л€»€Щ€А€Г€Н€Л€Ъ€В€Х€Ь€Ј€Н€Л€А€Ц€н€ў€Н€Ц€Щ€є€П€Ф€±€А€і€Ч€Ь€ѕ€ј€Н€Й€о€·€Д€А€ё€Б€Н€А€И€Ь€д€¶€ѕ€ј€М€Р€Н€П€К€а€к€А€е€Е€О€Ѕ€Ф€К€к€Г€Ц€І€»€±€№€Ы€±€Н€ѕ€ё€е€ѕ€Ю€Н€К€Д€щ€з€К€Г€Ш€Р€ї€З€Г€Ш€ј€З€·€»€ѕ€ѕ€Ї€Г€б€Ї€З€Х€Ы€О€№€Е€ф€Е€Ы€И€И€ґ€И€«€Р€М€В€Ц€і€В€А€Ј€і€·€Ы€ў€Г€±€е€»€Е€У€К€Ш€і€¬€Ы€§€К€Й€Ш€Л€Н€З€Ъ€д€Г€Ж€г€С€Д€Ї€Г€Е€І€Т€З€±€ј€і€Е€Б€И€ѕ€»€А€ѕ€В€»€»€°€Щ€С€Ч€Н€ў€ѕ€ѕ€Э€И€Э€У€і€К€Ь€Д€№€Л€·€®€Р€ѕ€Э€­€С€Д€г€ґ€®€ј€њ€±€Д€Е€А€ё€ј€°€д€Р€и€М€И€В€М€Ж€И€К€Й€ѕ€Э€а€і€ё€Ї€Ц€Ж€Л€О€У€П€Ы€ї€З€·€Н€П€Н€Й€Н€А€©€ј€К€ѕ€К€Д€¦€±€Я€З€К€і€Є€Г€і€Ы€©€Г€Х€«€№€ѕ€Я€є€Й€Р€Н€Щ€Г€°€ё€¶€ј€з€Ц€ѕ€П€К€№€·€№€Е€С€А€і€Д€А€Ш€И€»€ґ€¶€є€¶€џ€Ф€·€С€і€ї€И€З€И€Ы€Й€Т€Й€К€Л€М€ї€Р€Л€Н€Ц€Ґ€Ж€С€ѕ€Б€ј€Ї€В€З€ј€Д€­€Э€Й€М€Є€Ц€К€Ш€Д€Н€Б€Й€ґ€М€М€°€ѕ€І€И€°€А€С€№€®€Ъ€В€а€°€№€Н€µ€Ф€ѕ€Т€К€В€®€Л€Б€Б€л€Й€Е€К€І€Б€Р€ј€Ґ€Й€¬€Ю€®€Т€Ф€°€Х€і€ї€¶€Д€А‰€Л€з€ѕ€М€П€µ€Е€П€Є€»€°€д€Б€Е€Ў€Р€М€И€М€Ш€И€Ж€и‰‰^‰ЂЉ'Љ‹ЉЊ‡ЌtЌэЋXЋ%ЌэЌvЊ¦Њ‹2Љn‰—‰_€ы€э€л€Л€Я€Ч€М€Х€Ѕ€Г€Л€ґ€ё€є€§€Б€¬€Ф€З€Л€ѕ€К€Ж€Ґ€У€ї€±€Г€ё€Е€Й€ј€­€В€М€К€°€Т€Н€М€±€И€№€Ж€¦€И€О€О€ї€Л€И€П€Б€Л€З€ґ€і€Д€Н€±€ґ€Г€А€¦€®€А€µ€в€·€Ї€¤€Т€Й€Л€µ€Р€·€є€“€€є€Б€»€Ѕ€¦€Б€є€Ї€А€»€Ф€Ѕ€Х€®€Е€Д€ё€І€ї€Р€ё€°€Ї€Ґ€Ф€Д€¬€Ѕ€°€®€є€¦€°€є€Е€•€Ї€Ж€±€ј€ё€і€±€Ш€Д€є€·€Д€ѕ€Ж€ї€№€ё€µ€Ґ€ї€°€ѕ€І€¬€з€Ё€Б€е€В€П€¤€Ш€А€Г€ї€ѕ€М€¬€­€±€»€ё€В€А€є€ї€І€±€¶€Ѕ€Е€Б€Ю€Е€ґ€ј€а€Ѕ€А€М€ё€Ж€А€®€¤€Р€Ѕ€Ъ€№€Ё€¶€ј€·€ё€°€џ€®€Н€є€О€Ј€З€Є€Н€·€С€Б€·€°€Ѕ€О€®€Г€Т€ј€©€·€џ€±€І€є€ї€Ѕ€ѕ€Ї€№€·€Ф€Г€У€К€Ї€І€Н€Щ€Г€­€Ѕ€к€¬€»€К€О€±€¬€П€џ€џ€®€ј€Щ€·€µ€З€К€М€µ€ѕ€Ї€З€Ж€ѕ€Ѕ€З€Н€Е€Б€ѕ€Й€¬€В€¬€№€¦€В€С€®€Є€№€«€Д€©€і€Ц€Е€Є€А€ї€№€°€Ї€І€П€О€Т€З€Ў€П€і€§€і€в€­€«€і€№€·€В€Ѕ€±€И€»€і€¬€ё€љ€Г€»€ё€є€Л€Б€Г€¦€±€і€ѕ€П€Ї€Ц€џ€µ€Й€Б€Х€П€ё€К€ё€Д€Б€ѕ€»€¶€В€ў€·€ї€З€µ€Ї€џ€і€Е€Ё€©€»€С€О€И€¤€·€Д€Е€°€И€Г€Ж€ѕ€В€В€ќ€»€»€Н€е€Р€Н€Е€Ю€ј€Ф€Т€Ж€У€О€ґ€П€Б€Й€Е€¶€Ї€Ш€ѕ€Ц€ї€Е€Ё€ї€З€©€Ж€В€Л€ќ€А€·€©€«€И€ѕ€Ґ€ђ€±€Є€Ј€¶€Д€ €Ѕ€Я€Б€Ж€ћ€Є€µ€Д€µ€У€»€И€Д€Д€Б€З€°€Ф€А€Ф€Ѕ€ґ€Р€А€є€И€К€ €¬€Ґ€ј€№‰„€®€ґ€¬€®€А€«€¶€¬€«€К€Г€Г€В€№€і€ќ€Й€Ї€Ф€Г€ћ€Ж€µ€В€і€Г€і€М€Г€Ј€Г€»€ј€ї€·€Б€ї€Д€Г€і€ѕ€Н€І€Н€Й€«€ћ€Б€Т€ €Г€З€М€»€¤€·€»€љ€Ї€Њ€©€§€Й€Б€О€€§€В€Д€Ј€¦€µ€±€Є€«€«€¬€ё€Г€Ѕ€«€¬€°€ї€є€Г€¦€Ж€ќ€«€Ї€і€§€®€­€›€Ѕ€Ѕ€Б€¬€Ј€І€ґ€И€В€Ј€©€ґ€¶€Л€±€¦€ѕ€№€»€¶€№€»€ј€Л€±€–€№€А€§€Д€·€ј€К€Й€є€№€Ю€Ј€є€П€Ж€ї€·€З€Е€Щ€±€Б€Ґ€®€Є€І€Р€ґ€Ґ€№€±€ј€А€¶€¬€І€¶€¶€«€Є€Б€Ѕ€Ѕ€З€Ј€Д€М€Ё€µ€Ѕ€Д€В€®€®€І€°€і€©€§‰U€І€і€ €№€Д€µ€№€Ж€°€¬€В€®€П€Ш€ј€±€Ї€Н€І€ј€ґ€Н€°€џ€Ц€°€ё€є€Ї€­€О€¦€Ї€№€Ё€Ѕ€Б€Б€°€ў€°€М€Ж€ј€Л€ј€¤€У€ј€і€Ё€¶€Ї€Ц€Ѕ€И€­€Ѕ€З€є€ў€¬€¦€Ј€Ч€і€¬€Б€і€«€і€ј€ё€Ѕ€Г€µ€ґ€ё€И€З€ґ€Д€ґ€И€ї€¶€И€В€ј€Е€Л€ґ€­€ј€Д€©€Ё€®€Ц€Ё€ћ€ј€і€Г€А€»€°€Е€§€І€­€В€¶€ї€›€¤€і€і€«€±€И€і€Ј€µ€Д€ѕ€Г€Л€ё€¶€«€Ѕ€Ї€ѕ€·€Ѕ€ѕ€№€»€З€¤€Х€ґ€Ј€№€¶€¬€Є€™€¬€©€¶€·€ћ€Ж€І€№€µ€«€©€µ€ѕ€О€­€А€ё€ї€µ€И€ґ€Д€·€ј€ €И€ј€ї€І€ё€ј€І€»€§€¶€Ф€ї€±€Е€µ€В€Ч€ј€І€Д€Г€н€з€и€Я€Ч€Ш€Я€в€Г€Я€Ц€г€й€Э€У€ч€Ѕ€а€А€П€л€Ю€О€в€С€Щ€П€Л€У€К€М€Л€л€г€Э€М€Ы€Б€У€Д€°€Щ€ґ‰№€Ъ€Ъ€р€Ф€В€С€Э€Ъ€Ф€З€В€М€Б€а€Ч€Г€Ь€И€Ж€Х€Ї€Ъ€Ф€Й€О€№€ї€І€Ъ€і€О€Х€Ы€·€Х€µ€Р€Н€Ч€Д€ж€є€М€Г€К€Х€Г€Ж€Х€З€ё€З€З€Р€Л€®€Л€±€И€г€Щ€У€И€О€»€Ж€Ч€В€·€Г€Г€У€Б€±€П€л€Г€Ж€Д€Щ€№€Л€У€И€А€ё€Л€Е€о€Ж€¶€ї€в€У€Й€Щ€П€Й€Щ€І€Ш€Й€Ф€ј€№€Т€а€и€Ш€В€С€К€ё€О€У€І€µ€М€З€Ј€Г€ѕ€Ж€П€Ѕ€П€Ы€Б€«€Ж€Ѕ€µ€Ц€Ѕ€Х€ё€Ж€Э€а€°€в€Й€Р€в€Ц€Л€И€В€ї€Л€Ї€Ц€Г€µ€Я€З€Г€Й€И€»€Г€Х€А€О€З€§€И€ј€Э€П€П€Ш€Т€¶€ї€№€є€ї€µ€Ў€ё€Г€Е€К€И€І€Щ€°€Б€Ф€Б€Д€Р€Ж€Ю€К€°€ґ€У€Ї€Ч€И€Ш€Е€П€±€Д€°€И€П€Ё€Ж€О€І€Ї€И€Э€е€µ€Й€В€ґ€ґ€Ф€Ш€Ѕ€ё€љ€О€¬€ѕ€Р€З€№€Т€Й€К€Е€Д€µ€Ю€»€ґ€®€¦€Б€Ї€¶€Ч€Ѕ€Ф€Л€Ч€№€Ф€Д€±€Й€И€Ф€І€И€А€А€К€і€К€¶€¶€і€Й€µ€Б€Г€­€ѕ€А€¬€Л€В€ї€В€ј€П€»€Е€й€Д€Ѕ€П€Є€Ц€И€Ф€Э€№€Л€ґ€Ф€¦€Т€Х€ј€Ц€Н€·€К€¶€Б‰€П€Ў€№€М€Р€№€ґ€¶€њ€К€®€І€Н€В€С€»€ї€ґ€Л€ё€№€С€Ж€і€Ж€ё€є€і€»€Н€В€Х€П€Е€Ь€Г€Р€Щ€В€Ж€Г€А€К€№€Е€­€Ф€Е€І€®€ё€И€В€Е€С€Р€В€Г€Ж€¶€Є€µ€Н€©€Ј€С€ѕ€Д€В€»€¬€Ѕ€є€­€Ї€І€®€№€°€Щ€е€»€Ж€Ф€И€°€№€У€Ш€М€Ё€К€»€Д€Ю€О€С€Г€Р€Й€№€°€Ї€¬€Ф€Є€М€№€Ъ€¤€і€К€А€©€Ь€Ы€Ч€ћ€Ж€¶€Ѕ€З€Е€»€Ґ€®€Г€К€Г€ѕ€Ч€·€©€§€»€­€№€ё€Е€­€ѕ€О€°€Ж€М€Й€Б€Ф€Г€ё€є€В€Ж€»€ё€·€Я€ї€Б€ё€Г€ї€Ѕ€Ф€¶€У€№€О€М€П€Б€є€Б€ѕ€Й€ў€©€є€»€Ь€±€М€Ї€Б€ѕ€ґ€є€Ґ€®€ї€°€С€ґ€Б€Ѕ€А€А€Д€А€Ф€О€Є€Ё€Д€А€Г€Щ€Д€А€ј€±€¶€О€ј€ё€І€Ї€Г€є€О€ї€З€Ѕ€Й€»€©€±€ј€¶€З€ё€¶€В€С€Ў€®€Б€З€М€ё€»€ѕ€Ы€В€ґ€Б€Л€Л€Ї€ё€ј€Е€·€Г€®€О€И€Г€Ы€№€Ѕ€є€ї€Й€¬€†€±€№€В€И€б€ё€Д€Б€И€ґ€М€¦€ґ€¶€К€Т€Н€В€Б€і€С€ў€П€Ж€і€ѕ€З€Й€Г€»€·€З€Ж€­€·€±€ї€Ѕ€ё€Ї€И€С€Ш€ј€·€°€ѕ€К€¶€Й€Ж€Ї€Ґ€У€¶€±€У€И€№€Щ€Є€·€є€ѕ€Ё€·€µ€ї€Е€І€Е€Р€·€¶€У€Ж€є€Ч€Ї€­€Г€С€Е€Ѕ€Д€·€Ш€в€Ё€И€Х€њ€µ€В€О€Д€¤€®€Л€Г€Є€А€У€­€ї€Х€Т€Й€¶€Х€ј€Л€И€У€О€Д€Е€О€­€Г€°€Ь€З€ґ€ї€Д€ё€Щ€Д€Й€Р€ё€¶€ѕ€є€р€Ъ€З€Х€Ч€К€Б€Х€ћ€«€З€Ё€А€Л€Х€Я€К€є€П€¬€Й€Б€Н€Г€Ж€ѕ€ѕ€є€«€Й€з€Ѕ€Н€№€А€і€Т€ј€В€Р€Ы€Й€М€±€ѕ€Ѕ€Д€а€І€Ы€Ж€ё€¶€Н€›€Ѕ€ѕ€Э€А€Л€І€С€а€ґ€П€№€А€В€К€С€А€ј€С€­€®€Д€°€М€Ф€Ґ€Ц€К€¬€К€д€Б€±€Є€Г€ў€Ф€ў€С€Ѕ€л€Є€С€В€Ц€Х€Ч€ѕ€±€ќ€ѕ€і€±€О€И€Б€Е€А€Ѕ€¶€Ш€О€І€ј€Л€Ж€»€Г€ж€Г€ї€№€З€Х€г€Г€Д€»€а€Л€З€Р€ї€ґ€ї€Г€¶€Ї€и€·€Ы€г€Ч€Ё€У€С€Й€г€Т€ї€Ь€Ь€з€ї€Ч€Ф€Ё€П€Б€»€Ф€Ю€Ы€ё€·€М€З€±€К€Ч€ґ€Н€М€Й€ї€ј€ґ€ё€ё€З€В€Р€М€ё€»€·€Ъ€Р€Д€С€Й€»€В€°€М€К€Н€»€¶€А€Ы€А€Ѕ€Я€М€№€а€И€Ѕ€Ф€Ш€Р€ћ€М€М€Ъ€Ф€Л€Ъ€Д€·€¶€і€й€Ъ€Г€Ч€г€И€П€Я€ї€Г€ѕ€С€ї€ї€З€»€ё€З€ї€Ч€П€ґ€Ѕ€Л€з€С€Ъ€ј€Ы€·€ё€ї€Ж€Ѕ€»€є€С€П€Р€У€З€Ф€Г€М€Е€·€Ф€Ы€®€И€Н€ѕ€»€ї€І€К€Я€Ы€У€П€Х€±€Г€З€Ч€А€Т€З€Ч€Щ€В€Ы€Н€Л€Ф€Б€Л€Ж€л€І€ў€Л€Н€Э€·€Б€±€Ь€ѕ€Ы€Ф€Д€В€Ы€Г€І€Ь€·€П€±€Н€ѕ€»