€ґ€ё€№€ј€К€¤€В€И€ѕ€Б€°€›€І€Л€ј€ґ€­€Л€З€®€В€®‰1€і€ї€Г€Ѕ€®€±€С€Й€Ё€·€К€ј€ё€Р€±€©€ј€ё€°€В€®€д€Ю€®€µ€µ€¦€±€ї€Р€Ц€©€А€Л€Р€±€К€Т€ї€І€ѕ€Б€Щ€Ы€і€Ї€¦€Ф€У€·€Б€µ€Д€Е€·€є€є€В€ћ€Б€Е€ї€Г€Ѕ€Ь€®€­€Ґ€¶€Ф€·€®€І€µ€Д€«€Е€µ€ё€¶€Л‰ €¬€ѕ€Б€·€ґ€¦€·€¶€Л€®€Б€·€Ў€Ѕ€Ґ€¶€·€ѕ€Ф€И€Б€»€С€¦€К€ €Ў€°€—€Е€ў€є€”€ї€ґ€»€Ѕ€°€Н€ґ€Ѕ€Ё€Д€А€К€°€В€І€ё€Е€Д€·€µ€Ж€К€є€Ѕ€°€Щ€З€Н€¶€Ж€К€«€є€­€ї€№€З€ї€Ф€Ѕ€°€З€­€ѕ€А€д€Н€Д€±€¶€А€є€Д€В€·€Д€і€ґ€±€·€В€µ€д€¬€ї€µ€И€ў€Ё€»€Є€°€Г€ј€Е€Е€К€У€ъ€Ш€в€г€Й€У€ё€Й€Б€К€У€¶€Ж€Ё€«€Ї€§€№€ѕ€µ€Й€©€И€©€ѕ€Є€І€Ц€Ё€Ј€Ѕ€№€Б€ј€«€¬€В€¶€А€Б€ћ€Х€З€°€В€·€Ш€№€¤€·€©€¶€¬€®€Б€В€©€Є€±€®€і€°€ї€Є€±€№€И€·€»€Д€¤€ё€і€Б€ё€М€ґ€№€ґ€ё€ј€ґ€К€Є€ў€О€ѕ€Х€Ѕ€­€Й€џ€А€ґ€ё€т€Ј€ґ€¶€®€і€»€І€ї€±€Й€Ґ€»€Г€ј€ј€¤€Л€Ѕ€¶€є€ё€Ѕ€€Г€і€є€А€¶€џ€§€­€ё€Б€µ€©€Ъ€И€Р€¬€’€µ€К€В€ј€Н€Ё€­€Б€¤€ў€®€ґ€А€Ё€µ€Ї€є€М€І€ѕ€™€µ€І€Ґ€Г€ѕ€°€№€¶€·€§€Д€М€§€Ѕ€Ѕ€¦€Д€Е€ў€ћ€і€ѕ€Ё€ї€§€­€§€є€Ў€Л€И€±€Ў€°€Г€є€ў€І€¦€Ј€Ї€Е€­€Ч€­€і€¶€Є€·€є€»€Л€Б€«€№€»€±€Ф€­€О€Л€К€Ж€М€µ€»€·€©€¶€А€§€ї€¶€Г€Ё‰[€Н€Й€µ€Ж€Б€Д€ё€¤€џ€њ€Ш€ў€ё€Г€В€И€ќ€Є€ќ€ї€А€®€­€¦€№€¬€џ€Є€Е€¶€Ё€і€«€є€З€ё€·€і€№€Ј€К€µ€µ€°€Ѕ€±€¬€є€Т€ј€ў€¶€Б€±€®€№€Ј€ё€ћ€џ€®€П€ћ€ї€µ‰E€П€џ€і€ј€¬€»€«€»€Є€ґ€·€»€©€Ґ€ґ€Ї€Е€є€ў€¶€№€ј€Ї€Е€Ѕ€ґ€ґ€Л€Д€ґ€ѕ€¬€і€Є€є€µ€ј€№€·€Ґ€І€°€ё€Ѕ€І€·€ў€ј€К€Н€і€»€¶€·€°€·€№€Б€ќ€ј€­€¶€Д€А€І€Р€µ€А€¬€Ґ€ѕ€А€А€В€И€і€ё€ѕ€Ѕ€¶€±€Ц€—€И€Ф€з€Х€Ш€Х€Р€У€Ф€Ф€а€Ь€П€Ф€О‰€Ц€П€д€§€Т€з€»€ј€Х€Н€Л€Й€Ц€Д€О€З€Ш€ї€Ф€Ї€№€М€б€К€Ы€є€Ж€Д€З€Щ€Й€Э€Ш€Л€М€Д€М€К€Г€Ю€А€Ш€Э€Г€Х€И€Ш€Ь€л€Р€Ъ€Д€О€Э€Ъ€Й€Т€З€ё€Й€Ф€Й€Х€Ь€Р€М€Т€К€Ш€¦€ј€З€Н€Д€Й€¬€‘€ґ€И€є€Ж€Ь€ј€О€Ч€Г€В€К€С€Й€ї€Г€С€И€¬€·€Х€К€є€Ц€г€А€Х€·€Э€і€Р€ј€л€¶€Е€и€Ю€µ€Л€М€М€Б€ѕ€Е€В€ґ€є€Б€а€·€Т€С€А€К€Г€Ѕ€О€¤€У€П€Д€Е€О€Н€Щ€І€А€Щ€и€ј€П€Т€М€В€И€Л€Б€В€Ы€Ё€Е€Т€г€С€В€ж€Ї€і€В€Г€Х€П€№€Щ€У€І€Е€ґ€Д€Й€г€к€ґ€в€Ь€У€л€ъ€с‰€Ч€у‰	€ъ‰	€з€Я€Ь€Ы€р€Й€з€И€Щ€Т€ѕ€С€Ь€Ъ€й€Щ€Т€Т€С€Р€О€С€Ѕ€К€Ц€П€ј€Ж€З€Г€У€І€Й€У€Щ€і€ї€к€Ч€°€Л€Б€Ї€П€Т€»€Д€Н€Х€Г€З€Ь€Ж€В€С€«€Ё€й€Ч€А€З€А€О€Й€ё€›€ґ€і€Д€Р€­€А€Х€Т€ѕ€®€®€¶€Й€·€Г€з€­€А€­€Х€П€К€О€Р€ј€»€№€З€Ж€Ь€С€Д€Л€г€А€є€Ж€Е€Б€Д€Б€Ы€Д€И€ј€ё€Е€є€В€И€Ц€Т€С€Б€¬€Е€Ы€Ц€В€Ъ€Ш€Э€У€С€ї€І€ј€Ї€ѕ€Б€Б€І€ї€·€Ц€¤€Е€Ч€Е€±€¤€Ж€Й€ґ€О€І€Е€В€Ю€Л€ї€–€Б€»€Щ€Н€ї€И€©€В€Ц€Ј€њ€Д€Г€Л€»€Д€¶€З€З€Н€Т€ї€Н€Г€а€З€·€Є€ї€Т€Ѕ€№€Б€№€і€Ш€Ь€Ь€ѕ€Ї€Ё€ґ€Ж€П€З€ѕ€ј€Ѕ€·€µ€»€В€°€Й€Д€·€µ€ѕ€¶€ј€µ€ €»€Ѕ€К€Ш€Д€і€ј€№€О€¦€Е€І€є€Н€№€ё€·€№€Т€В€ё€С€њ€У€Н€Ь€в€є€П€¶€К€Ѕ€Л€Г€»€У€Ь€С€±€ї€±€К€О€ґ€±€ґ€ї€ї€В€ј€ €·€г€±€ѕ€ћ€­€З€Д€Н€Е€ґ€»€Ь€ѕ€О€А€Б€Ф€Н€Н€ґ€ј€О€А€є€О€І€У€В€Щ€Г€Х€Ы€С€®€Х€®€Г€ј€Й€І€·€З€є€°€»€№€П€Ѕ€®€ї€ё€·€Д€Н€Ѕ€ё€Е€Ф€В€Т€М€¦€¬€Е€Л€ё€»€ј€Ь€№€ј€П€К€Ж€Р€Ю€№€П€Ч€В€µ€ґ€»€»€№€ѕ€Ц€ї€№€М€З€Ѕ€»€М€ј€Б€¤€і€¤€ґ€О€¬€№€Ё€В€Е€ў€Є€О€Й€Ф€Ў€ї€Л€ґ€А€К€©€Г€ё€В€ї€ѕ€»€®€±€Э€ї€µ€П€ё€Д€µ€М€Ѕ€ј€Ж€Д€є€є€ё€№€¬€§€Х€В€ѕ€°€Е€¦€»€µ€ј€І€е€і€К€Ц€Ў€Ж€±€ї€Я€”€Ѕ€М€У€±€®€К€°€з€Р€Л€С€ѕ€§€М€·€ё€№€»€ј€­€ѕ€є€С€А€Д€Л€Ѕ€Ж€О€ж€№€њ€±€Е€П€В€є€И€Ж€Л€і€Г€В€№€З€µ€Х€±€®€№€В€ё€Ш€Э€М€Л€ј€Р€Ф€Д€З€¶€И€В€Ж€Ґ€ї€ј€П€µ€ј€§€М€Х€В€Ф€Л€Д€К€П€ё€»€Ш€Е€·€є€»€¶€Є€Б€Б€­€Ы€ї€Ж€К€К€і€Й€Й€Э€У€Л€Ж€И€¶€»€Б€№€є€П€Й€ё€Ё€±€Ѕ€М€®€є€к€°€М€Н€№€Б€А€ €¶€О€О€ј€є€Э€›€µ€А€Л€І€Ч€А€М€Х€Е€Ѕ€Ф€ѕ€Т€О€І€Ф€№€С€С€Ч€А€М€Ш€О€ї€А€ё€Р€Ў€№€¶€¶€В€ґ€И€Ѕ€»€Й€ј€°€¶€Й€–€є€А€Б€ґ€·€©€Д€І€В€Ѕ€А€а€й€Б€Р€ґ€В€Т€Д€Д€є€Х€Г€Є€Р€Е€д€П€і€В€Р€В€Е€Э€У€В€Г€К€ё€Щ€·€Х€ї€ѕ€Р€»€¶€±€Б€њ€±€Ґ€Ф€К€И€¶€О€Д€Э€В€Э€Н€К€¶€µ€в€¦€·€Ч€ѕ€±€Ґ€Л€г€Л€ґ€є€­€З€ї€И€·€є€ї€З€ё€Г€Г€Ч€С€Ж€ї€№€С€Ъ€№€№€А€ћ€Ѕ€Р€Ж€є€·€І€ј€·€Б€»€і€М€Е€К€Л€ї€И€®€ї€Л€Й€Д€Ч€Ы€ї€°€М€Ч€Э€Ї€А€¬€Г€Ю€Щ€¶€а€µ€Н€О€»€а€А€М€З€Х€Р€Ш€Р€З€К€А€ј€К€З€Х€є€є€Э€П€А€Й€Н€О€©€А€ё€К€·€Р€Є€Ь€Ґ€П€М€»€ё€В€ї€Ц€«€Ц€Ѕ€—€Х€Й€ї€Т€С€Р€Ь€Г€»€А€В€¶€Ч€Е€Р€№€Л€Й€Ц€Ц€Р€Л€м€П€џ€М€П€М€±€Н€Р€Л€В€В€Ь€и€Х€Э€Й€ѕ€Ф€О€Т€Ц€С€А€У€З€Ч€Ф€К€Ѕ€у€Х€¬€Й€д€Н€Р€К€Т€М€І€И€Л€б€Ф€№€О€Й€Д€И€О€Н€ј€Ь€К€Н€Т€¶€О€Ѕ€М€ї€»€Э€°€И€Г€Б€И€О€®€Н€ґ€®€·€Е€А€В€Б€ї€а€Ф€Б€ѕ€Б€ѕ€ё€ё€Й€В€П€ж€И€ѕ€Б€У€С€Ъ€Ѕ€є€з€ё€С€Ж€­€Е€І€ј€№€Ц€Ш€Й€°€Р€Н€В€ґ€А€¤€И€С€ґ€ѕ€Ъ€М€Т€Ж€Я€Г€Ж€Г€П€·€Ы€Ѕ€і€»€Й€Г€®€Б€П€Ъ€Л€Ѕ€Д€Г€Л€Ы€А€є€П€ї€г€Ж€Ч€е€П€·€П€Ы€Ж€Ы€У€·€Щ€Е€Б€ї€Е€И€И€¦€П€Д€Ю€Т€ї€№€К€Г€Н€Г€К€і€У€О€Е€Н€№€Б€Л€ѕ€Р€ј€Д€ї€ї€Т€Р€ё€·€З€Ы€Ж€В€Й€Г€Г€С€Й€Р€·€Н€М€О€И€й€ј€А€Е€Д€Д€К€Ш€ё€¶€є€Э€є€Ц€Г€С€И€Э€Г€У€Ж€ў€¶€Б€Г€ї€З€П€Ф€і€Я€»€Э€К€Ч€»€б€М€Щ€Щ€Е€ґ€ф€І€Ю€М€К€ѕ€Е€Л€А€Ы€У€¤€Е€Т€»€Х€Ь€Ь€Н€З€¶€Т€О€М€Б€Л€Л€ї€К€В€Щ€Щ€П€»€Б€О€Д€Ч€Е€Д€Г€ €Б€Ф€Т€Ѕ€Д€О€¬€Щ€О€І€Н€Ш€Т€­€Ч€К€И€Й€Д€ї€У€ѕ€Ю€Ш€Ѕ€§€П€Л€Ъ€К€Г€Х€Г€µ€ЗЉп€М€З€Т€б€Н€ґ€Б€Б€Ц€Д€Ь€Т€Ф€Э€ж€Ц€з€Ф€В€Ѕ€Н€Л€Ж€Я€О€О€С€Н€У€Г€Н€¶€К€Л€ї€ѕ€У€С€©€Ѕ€Ч€Х€Т€К€А€Х€Ъ€У€Б€А€О€Б€Г€В€є€Й€Ж€Ч€·€Н€ґ€Й€µ€У€ё€В€К€А€»€Ё€ї€С€Т€Л€Ф€П€Д€Б€»€К€Й€М€Ь€Е€Г€М€¶€Ф€Т€З€Ъ€С€Ш€­€Э€З€є€І€¬€О€Я€±€Ы€а€Ѕ€Ч€ё€Ч€М€И€№€К€Й€Ш€Д€ґ€З€М€ј€А€°€г€К€Т€Ц€¤€і€П€«€­€М€Г€Е€№€Ж€ж€н€ѕ€ё€«€і€Ш€Ч€ґ€Б€µ€¶€Б€ѕ€К€И€С€ё€З€Г€¶€В€Ф€П€ї€№€Е€¶€Г€Я€ј€В€№€Ў€З€М€Л€Ж€Д€№€Р€Х€Б€¶€Ф€®€Ж€В€Й€ѕ€Н‰Ў€б€Ъ€№€Ж€К€Ж€№€О€Г€­€Н€є€·€Е€О€А€·€Н€Ь€З€Ш€З€ј€Ф€Г€И€Ы€ё€А€Ы€¶€З€М€О€Е€Л€Г€ј€Н€Р€Г€ї€І€И€А€Я€ї€г€ј€ё€і€П€Х€Д€М€Ы€Й€Д€є€Ю€Е€Р€ё€Х€Н€Д€А€¶€Ф€Ш€Р€А€Ј€Ф€В€Ш€Ф€Н€В€Г€О€°€в€Н€б€і€Т€Г€І€Ш€Л€»€Й€П€ј€З€Б€Ш€Л€А€Н€и€ј€Й€ѕ€а€Т€є€М€й€є€Е€ї€ѕ€Ж€Ї€Д€С€Щ€«€З€ж€В€Д€Л€ї€Щ€П€Д€Г€Л€а€Г€В€№€Л€Ш€·€Ѕ€М€Щ€Ё€Ѕ€М€В€Д€В€Ц€ѕ€·€ё€Н€ї€З€·€В€І€П€Й€Н€Е€З€С€К€ѕ€Т€Ѕ€Ъ€Е€Л€й€Ъ€Щ€И€Ч€а€Й€Т€в€»€ј€Д€Е€Й€З€Ь€Ж€м€Р€П€А€С€И€А€Ѕ€В€Є€Ц€Ъ€Ц€Н€б€Б€Е€Б€є€Д€О€ё€М€Г€О€З€Є€ё€ї€·€Э€С€А€З€З€ґ€Д€Ф€Л€і€М€Ю€А€Х€«€ѕ€Н€А€К€№€Ч€Ж€В€Й€Р€Н€№€Г€ґ€А€Ш€Ф€Ы€¶€М€Т€Т€Й€г€А€г€З€Д€П€И€№€Ґ€Р€ї€¬€¦€¶€а€·€а€б€Л€Ж€і€в€ѕ€Ѕ€Ѕ€»€Ј€П€И€Т€Ѕ€Г€Ѕ€о€Х€Ю€У€в€Х€Ъ€Г€Е€С€ѕ€У€±€а€Ц€Б€Э€Ф€В€С€И€ґ€Ш€Ѕ€А€І€ј€А€Т€Ъ€Ы€Д€Ю€Б€З€Н€Т€з€В€Ѕ€Р€У€ч€Э€Т€В€З€Е€К€Я€З€Б€Ф€Й€·€Е€Ф€Ь€М€З€Д€Д€И€Ж€µ€є€љ€К€С€Ь€П€Г€Е€ј€А€№€С€Ъ€в€Д€Ж€А€У€·€ф€©€В€№€і€Р€И€Щ€К€Н€В€М€а€ї€ц€Й€Ш€О€·€Н€ґ€Ю€·€н€ѕ€ѕ€С€Е€в€Б€Ѕ€Т€Р€Н€Ц€О€Б€є€А€і€©€ѕ€Й€ѕ€Б€є€Ї€¦€Ї€А€л€Я€П€Л€Ц€Л€П€Й€З€Ї€Ѕ€±€ј€Ѕ€Й€Ф€°‰t€Т€Ф€К€Р€¶€»€Д€З€ѕ€»€Г€Ь€і€»€П€С€И€Ч€Л€Г€®€–€Б€«€Б€Й€№€¶€«€¶€Ъ€Д€З€Й€»€ї€ё€Ѕ€И€Л€Й€А€В€Ж€Й€Ж€а€ї€µ€И€С€А€§€ґ€К€М€ё€У€Ж€Ѕ€°€М€П€«€Ъ€Р€В€Ї€Ѕ€й€Д€Г€Х€Т€ј€ѕ€µ€М€У€Ж€Е€Ж€А€Е€С€¬€Ѕ€ґ€ѕ€є€ѕ€ґ€М€Б€«€±€Ш€А€М€§€ѕ€ј€ѕ€Ж€µ€«€Р€Л€Ї€Ж€©€А€Ѕ€Ѕ€Б€ј€А€ѕ€В€М€¦€Ф€Й€і€®€Л€Ю€Ю€µ€Й€Г€Б€Й€°€Д€П€Ъ€ѕ€В€Ё€Е€ї€і€Э€Ж€Ж€Б€Н€ѕ€Г€Й€ґ€В€Ї€Г€Д€Т€µ€С€Н€¶€µ€Ё€®€Ё€ї€К€В€г€Р€·€Й€Л€µ€є€Б€¬€Й€В€Б€Ж€И€И€Ї€Є€П€ѕ€И€ї€С€Ј€С€І€Е€ґ€•€А€Й€І€Ё€М€ѕ€А€№€®€Ж€б€Ш€¶€µ€ї€ґ€Р€С€Д€Ѕ€Ж€ё€Т€Т€И€Г€Ж€ї€Ї€ѕ€ї€µ€Ч€С€§€Ы€Р€Х€І€Й€ї€Ж€ј€Л€ј€У€Ї€ѕ€·€А€Ч€»€і€±€є€№€Е€У€К€µ€є€Ж€Е€і€Ж€і€µ€М€«€Ѕ€Г€И€О€Ї€ё€Е€к€µ€З€Ж€А€Г€І€П€У€ѕ€»€Х€Б€Ѕ€і€З€°€Д€Ё€ї€›€И€є€¶€б€З€К€і€Ї€Р€»€і€Ы€±€М€Ѕ€Ѕ€µ€є€ґ€И€ј€Р€§€ѕ€¶€ћ€В€і€Е€Ч€±€»€Л€¬€©€Ф€™€Г€®€А€¶€Ц€Й€З€И€Ѕ€№€®€Г€К€°€ѕ€№€©€Џ€ѕ€Й€Д€є€Ѕ€№€ѕ€ѕ€·€О€І€Е€Ї€Е€™€Н€¬€№€І€Ш€¶€¶€Д€ї€°€«€Л€®€»€Ф€Й€і€«€Й€К€°€З€­€Т€Ч€¬€З€ј€Л€П€Ж€№€¬€Ї€С€Ј€Ё€ґ€ї€Д€П€І€°€е€Ё€№€П€В€¶€А